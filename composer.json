{
  "name": "javaabu/stencil",
  "description": "Fluent form schemas for Laravel: define a form once in PHP and render it with Blade (javaabu/forms) or Inertia React (@javaabu/forms), with model binding, validation and closure-evaluated, conditional props.",
  "homepage": "https://github.com/Javaabu/stencil",
  "license": "MIT",
  "keywords": [
    "javaabu",
    "laravel",
    "stencil",
    "forms",
    "form-builder",
    "schema",
    "blade",
    "inertia",
    "react",
    "dhivehi"
  ],
  "authors": [
    {
      "name": "Javaabu Pvt. Ltd.",
      "email": "info@javaabu.com",
      "homepage": "https://javaabu.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/routing": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "illuminate/validation": "^12.0 || ^13.0",
    "illuminate/view": "^12.0 || ^13.0",
    "javaabu/forms": "^2.0@dev",
    "javaabu/manifest": "^1.0@dev"
  },
  "require-dev": {
    "javaabu/boost-javaabu-guidelines": "^1.4",
    "javaabu/translatable": "^3.0@dev",
    "laravel/pint": "^1.24",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5.3 || ^12.5.8"
  },
  "suggest": {
    "javaabu/translatable": "Per-locale inputs for translatable fields (^3.0)"
  },
  "autoload": {
    "psr-4": {
      "Javaabu\\Stencil\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Javaabu\\Stencil\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-clover=clover.xml",
    "lint": "vendor/bin/pint --test",
    "format": "vendor/bin/pint"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.x-dev"
    },
    "laravel": {
      "providers": [
        "Javaabu\\Stencil\\StencilServiceProvider"
      ],
      "aliases": {
        "Stencil": "Javaabu\\Stencil\\Facades\\Stencil"
      }
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/Javaabu/forms",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/Javaabu/manifest",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/n4ff4h/translatable",
      "no-api": true
    }
  ],
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
